---
import { getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import photo from "@/photo.jpg";
import wechatQr from "@/1.jpg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error(
    "Missing content entry: `about.md` or `about.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(about);
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={about.data.title} class="app-prose">
    <div
      class="not-prose border-border mb-10 flex items-center gap-3 border-b pb-6"
    >
      <span class="text-accent text-xl" aria-hidden="true">✦</span>
      <span class="text-muted-foreground text-sm tracking-wide"
        >PERSONAL PROFILE</span
      >
      <span class="bg-border h-px flex-1" aria-hidden="true"></span>
    </div>
    <div class="about-content">
      <img
        src={photo.src}
        alt="Qicheng Gao"
        width={photo.width}
        height={photo.height}
        class="profile-photo"
      />
      <Content />
      <Image
        src={wechatQr}
        alt="Scan to follow Elanor Garden on WeChat"
        width={360}
        format="png"
        loading="lazy"
        class="wechat-qr"
      />
    </div>
  </Main>

  <Footer />
</Layout>

<style>
  .wechat-qr {
    width: 160px;
    max-width: 100%;
    height: auto;
    margin-top: 1rem;
  }

  .profile-photo {
    float: right;
    width: 38%;
    max-width: 240px;
    height: auto;
    margin: 0 0 1.5rem 1.5rem;
    border-radius: 0.75rem;
  }

  .about-content :global(h2) {
    clear: both;
    color: var(--accent);
  }

  .about-content :global(li::marker) {
    color: var(--accent);
  }

  @media (max-width: 480px) {
    .profile-photo {
      float: none;
      width: 180px;
      margin: 0 auto 1.5rem;
    }
  }
</style>
